rules_version = '2';
// =====================================================================
// Regras do Firestore: coleira inteligente + rede de alerta do bairro
//
// Quem é quem:
//   tutor    conta com e-mail e senha; é o "dono" em acesso/{pet}
//   coleira  conta anônima criada pela própria coleira; o tutor cola o UID
//            dela no site e ela vira a "coleira" em acesso/{pet}
//   achador  quem escaneia o QR; login anônimo automático (sem dados pessoais)
//   vizinho  conta com e-mail e senha que entrou na rede (vizinhos/{uid})
//   tutores/{uid} e pets/{pet}/config/ficha guardam dados pessoais: só o dono lê
//
// Princípios:
//   - a posição da coleira, a saúde e os alertas só são lidos pelo tutor e
//     pela coleira (a posição em casa revela o endereço);
//   - o perfil público do QR (perfis/{pet}) é lido por id, nunca listado;
//   - na rede do bairro só existe área aproximada (quadrícula de ~1 km);
//     avistamentos com o ponto exato só são vistos pelo tutor;
//   - tudo o que não está liberado aqui é negado.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- utilidades
    function logado() { return request.auth != null; }
    function contaReal() {
      return logado() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function caminhoAcesso(pet) { return /databases/$(database)/documents/acesso/$(pet); }
    function temDono(pet) { return exists(caminhoAcesso(pet)); }
    function ehDono(pet) {
      return contaReal() && temDono(pet) && get(caminhoAcesso(pet)).data.dono == request.auth.uid;
    }
    function ehColeira(pet) {
      return logado() && temDono(pet) && get(caminhoAcesso(pet)).data.get('coleira', '') == request.auth.uid;
    }
    function ehDonoOuColeira(pet) { return ehDono(pet) || ehColeira(pet); }
    function membro() {
      return contaReal() && exists(/databases/$(database)/documents/vizinhos/$(request.auth.uid));
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    function idPetValido(pet) { return pet.matches('^[a-z0-9_-]{2,40}$'); }
    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function latOk(v) { return v == null || (v is number && v >= -90 && v <= 90); }
    function lngOk(v) { return v == null || (v is number && v >= -180 && v <= 180); }
    function celulaOk(c) { return c is string && c.matches('^-?[0-9]{1,3}[.][0-9]{2}_-?[0-9]{1,3}[.][0-9]{2}$'); }

    // ---------------------------------------------------------------- dono do pet
    match /acesso/{pet} {
      // o tutor vê o próprio registro; "resource == null" deixa ver que o pet ainda não tem dono
      allow get: if contaReal() && (resource == null || resource.data.dono == request.auth.uid);
      allow create: if contaReal() && idPetValido(pet)
        && request.resource.data.keys().hasOnly(['dono', 'coleira', 'criadoEm'])
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.get('coleira', null) == null;
      // o tutor só pode trocar a coleira vinculada (nunca o dono)
      allow update: if contaReal() && resource.data.dono == request.auth.uid
        && soMudou(['coleira'])
        && (request.resource.data.coleira == null
            || (request.resource.data.coleira is string
                && request.resource.data.coleira.matches('^[A-Za-z0-9]{20,128}$')
                && request.resource.data.coleira != request.auth.uid));
    }

    // ---------------------------------------------------------------- perfil público (página do QR)
    function perfilValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'foto', 'telefone', 'recado', 'perdido', 'perdidoDesde', 'encontrado', 'atualizadoEm',
                               'especie', 'raca', 'cor', 'porte', 'cuidados'])
        && texto(d.get('nome', ''), 40) && texto(d.get('foto', ''), 400000)
        && texto(d.get('telefone', ''), 20) && texto(d.get('recado', ''), 300)
        && d.get('perdido', false) is bool
        && d.get('especie', 'cao') in ['cao', 'gato', 'outro']
        && texto(d.get('raca', ''), 40) && texto(d.get('cor', ''), 80)
        && d.get('porte', '') in ['', 'pequeno', 'medio', 'grande'] && texto(d.get('cuidados', ''), 120);
    }
    // quem achou marca "encontrado" apontando para o encontro que ELE criou; sem nome nem telefone
    function encontradoPeloAutor(pet) {
      let e = request.resource.data.encontrado;
      return e is map && e.keys().hasOnly(['encontroId', 'em']) && e.encontroId is string
        && e.em == request.time
        && get(/databases/$(database)/documents/pets/$(pet)/encontros/$(e.encontroId)).data.autor == request.auth.uid;
    }
    match /perfis/{pet} {
      allow get: if true;
      allow list: if false;
      allow create: if ehDono(pet) && perfilValido();
      allow update: if (ehDono(pet) && perfilValido())
        || (ehColeira(pet) && soMudou(['perdido', 'perdidoDesde', 'encontrado'])
            && request.resource.data.perdido is bool && request.resource.data.get('encontrado', null) == null)
        || (logado() && soMudou(['encontrado']) && encontradoPeloAutor(pet));
      allow delete: if ehDono(pet);
    }

    // ---------------------------------------------------------------- dados do tutor (só ele lê e grava)
    match /tutores/{uid} {
      allow read, delete: if contaReal() && request.auth.uid == uid;
      allow create, update: if contaReal() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'mostrarTelefone', 'layout', 'atualizadoEm'])
        && texto(request.resource.data.get('nome', ''), 60) && texto(request.resource.data.get('telefone', ''), 20)
        && request.resource.data.get('mostrarTelefone', true) is bool
        && (request.resource.data.get('layout', {}) is map && request.resource.data.get('layout', {}).size() <= 10);
    }

    // ---------------------------------------------------------------- dados privados do pet
    match /pets/{pet} {
      allow read, write: if ehDonoOuColeira(pet);

      match /config/{doc} { allow read, write: if ehDonoOuColeira(pet); }
      match /saude/{dia}  { allow read, write: if ehDonoOuColeira(pet); }

      match /alertas/{id} {
        allow read: if ehDono(pet);
        allow create: if (ehDonoOuColeira(pet) && texto(request.resource.data.mensagem, 600))
          || (logado() && avisoDeQuemAchou(pet));
      }

      match /encontros/{id} {
        allow get: if ehDono(pet) || (logado() && resource.data.autor == request.auth.uid);
        allow list: if ehDono(pet);
        allow create: if logado() && temDono(pet) && encontroNovo(pet);
        allow update: if
          (ehDono(pet) && soMudou(['status', 'respostas'])
            && request.resource.data.status in ['aberto', 'a_caminho', 'resolvido']
            && respostasOk('tutor'))
          || (logado() && resource.data.autor == request.auth.uid && resource.data.status != 'resolvido'
            && soMudou(['respostas', 'lat', 'lng', 'precisao', 'mapaEm'])
            && latOk(request.resource.data.lat) && lngOk(request.resource.data.lng)
            && respostasOk('achador'));
      }
    }

    function avisoDeQuemAchou(pet) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pet', 'tipo', 'encontroId', 'mensagem', 'lat', 'lng', 'precisao', 'contatoNome', 'contatoTelefone', 'criadoEm'])
        && d.tipo == 'avistamento' && d.pet == pet && texto(d.mensagem, 800)
        && texto(d.get('contatoNome', ''), 60) && texto(d.get('contatoTelefone', ''), 20)
        && latOk(d.get('lat', null)) && lngOk(d.get('lng', null))
        && get(/databases/$(database)/documents/pets/$(pet)/encontros/$(d.encontroId)).data.autor == request.auth.uid;
    }
    function encontroNovo(pet) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pet', 'autor', 'criadoEm', 'mapaEm', 'lat', 'lng', 'precisao', 'achador',
                               'mensagem', 'estadoPet', 'ondeFica', 'foto', 'status', 'respostas'])
        && d.autor == request.auth.uid && d.pet == pet
        && d.status == 'aberto' && d.respostas is list && d.respostas.size() == 0
        && d.criadoEm == request.time && (d.mapaEm == null || d.mapaEm == request.time)
        && latOk(d.lat) && lngOk(d.lng) && (d.precisao == null || d.precisao is number)
        && d.achador is map && d.achador.keys().hasOnly(['nome', 'telefone'])
        && texto(d.achador.nome, 60) && texto(d.achador.telefone, 20)
        && texto(d.mensagem, 600) && texto(d.foto, 300000)
        && d.estadoPet in ['', 'bem', 'assustado', 'machucado']
        && d.ondeFica in ['', 'comigo', 'no_local', 'levei'];
    }
    // a conversa só cresce: uma mensagem nova por vez, de quem está escrevendo
    function respostasOk(de) {
      let antes = resource.data.respostas;
      let depois = request.resource.data.respostas;
      return depois == antes
        || (depois.size() == antes.size() + 1 && depois.size() <= 80 && depois.hasAll(antes)
            && depois[antes.size()] is map
            && depois[antes.size()].keys().hasOnly(['de', 'texto', 'em'])
            && depois[antes.size()].de == de
            && texto(depois[antes.size()].texto, 400) && texto(depois[antes.size()].em, 40));
    }

    // ---------------------------------------------------------------- rede de alerta do bairro
    // participação: só o próprio vizinho lê e grava (ninguém vê quem mora onde)
    match /vizinhos/{uid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if contaReal() && request.auth.uid == uid && vizinhoValido();
    }
    function vizinhoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['apelido', 'bairro', 'celula', 'raio', 'autoPublicar', 'criadoEm', 'atualizadoEm'])
        && texto(d.apelido, 30) && d.apelido.size() >= 2 && texto(d.bairro, 50)
        && celulaOk(d.celula) && d.raio in [1, 2, 3] && d.get('autoPublicar', false) is bool;
    }

    // alerta do bairro: id = id do pet (um alerta por pet), só área aproximada
    match /bairro/{pet} {
      allow get: if membro() || ehDono(pet);
      allow list: if membro();
      allow create: if ehDono(pet) && membro() && alertaValido(pet) && request.resource.data.desde == request.time;
      allow update: if ehDono(pet) && membro() && alertaValido(pet);
      allow delete: if ehDono(pet);

      // "estou procurando": aparece só o apelido
      match /ajudantes/{uid} {
        allow read: if membro() || ehDono(pet);
        allow create: if membro() && request.auth.uid == uid && alertaAtivo(pet)
          && request.resource.data.keys().hasOnly(['apelido', 'em'])
          && texto(request.resource.data.apelido, 30) && request.resource.data.em == request.time;
        allow delete: if logado() && request.auth.uid == uid;
      }

      // "vi este pet": ponto exato, visível só para o tutor e para quem enviou
      match /avistamentos/{id} {
        allow get: if ehDono(pet) || (logado() && resource.data.autor == request.auth.uid);
        allow list: if ehDono(pet);
        allow create: if membro() && alertaAtivo(pet) && avistamentoValido();
      }
    }
    function alertaAtivo(pet) {
      return get(/databases/$(database)/documents/bairro/$(pet)).data.status == 'ativo';
    }
    function alertaValido(pet) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pet', 'nome', 'foto', 'descricao', 'bairro', 'celula', 'celulas', 'status', 'desde', 'atualizadoEm', 'encerradoEm'])
        && d.pet == pet && texto(d.nome, 40) && texto(d.foto, 400000)
        && texto(d.descricao, 200) && texto(d.bairro, 50)
        && celulaOk(d.celula) && d.celulas is list && d.celulas.size() <= 49 && d.celulas.hasAny([d.celula])
        && d.status in ['ativo', 'resolvido'];
    }
    function avistamentoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['autor', 'apelido', 'lat', 'lng', 'precisao', 'nota', 'em'])
        && d.autor == request.auth.uid && texto(d.apelido, 30) && texto(d.nota, 200)
        && d.lat is number && d.lng is number && latOk(d.lat) && lngOk(d.lng)
        && (d.precisao == null || d.precisao is number) && d.em == request.time;
    }

    // denúncias: qualquer vizinho envia, ninguém lê pelo app (moderação pelo console)
    match /denuncias/{id} {
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['alvo', 'motivo', 'autor', 'em'])
        && request.resource.data.autor == request.auth.uid
        && texto(request.resource.data.alvo, 60) && texto(request.resource.data.motivo, 300)
        && request.resource.data.em == request.time;
    }
  }
}
