rules_version = '2';
// Regras ABERTAS para o prototipo / apresentacao: qualquer pessoa com a
// configuracao do projeto pode ler e escrever. Antes de usar de verdade,
// adicione autenticacao (Firebase Auth) e restrinja a escrita ao tutor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pets/{pet}      { allow read, write: if true; }
    match /config/{doc}    { allow read, write: if true; }
    // perfil publico do pet (lido pela pagina do QR)
    match /perfis/{pet}    { allow read: if true; allow write: if true; }
    // a pagina do QR so pode CRIAR avisos, nunca apagar ou editar
    match /alertas/{id}    { allow read, create: if true; }
  }
}
